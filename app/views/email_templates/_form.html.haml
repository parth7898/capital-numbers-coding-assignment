= form_with(model: email_template, local: true, html: { class: "needs-validation" }) do |f|
  - if email_template.errors.any?
    .alert.alert-danger
      %h4.alert-heading
        = "#{pluralize(email_template.errors.count, "error")} prohibited this template from being saved:"
      %ul.mb-0
        - email_template.errors.full_messages.each do |msg|
          %li= msg

  .mb-3
    = f.label :subject, class: "form-label"
    = f.text_field :subject, class: "form-control", placeholder: "Enter template subject"

  .mb-3
    = f.label :body, class: "form-label"
    = f.text_area :body, rows: 10, class: "form-control", placeholder: "Enter email body"

  .d-flex.mt-3.email-buttons
    = f.submit "Save", class: "btn btn-primary"
    = link_to "Cancel", email_templates_path, class: "btn btn-secondary"
