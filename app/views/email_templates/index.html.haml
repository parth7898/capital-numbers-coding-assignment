%h1.text-center.mb-4 Email Templates

.div.text-end.mb-3
  = link_to "+ New Template", new_email_template_path, class: "btn btn-primary"

.row
  - @email_templates.each do |template|
    .col-md-6.col-lg-4.mb-4
      .card.shadow-sm.border-0
        .card-body

          %h5.card-title.text-primary= template.subject
          %p.card-subtitle.text-muted

          %hr

          = form_with url: preview_email_template_path(template), method: :get, local: true do |f|

            .mb-3
              %label.form-label.small.text-muted Select Contact for Preview
              = f.select :contact_id,
                  options_from_collection_for_select(Contact.all, :id, :name),
                  { prompt: "Choose Contact" },
                  class: "form-select form-select-sm", required: true

            = f.submit "Preview", class: "btn btn-success btn-sm w-100"

          %hr

          .d-flex.justify-content-between.mt-2
            = link_to "View", email_template_path(template), class: "btn btn-secondary btn-sm"
            = link_to "Edit", edit_email_template_path(template), class: "btn btn-primary btn-sm"
            = link_to "Delete", email_template_path(template),
                method: :delete,
                data: { confirm: "Are you sure?" },
                class: "btn btn-danger btn-sm"
