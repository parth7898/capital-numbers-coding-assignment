%h1.text-center.mb-4 Email Templates
.div.text-end.mb-3
  = link_to "+ New Template", new_email_template_path, class: "btn btn-primary"

%table.table.table-striped.table-bordered
  %thead
    %tr
      %th ID
      %th Subject
      %th Actions
  %tbody
    - @email_templates.each do |template|
      %tr
        %td= template.id
        %td= template.subject
        %td
          = link_to "View", email_template_path(template), class: "btn btn-secondary btn-sm me-1"
          = link_to "Edit", edit_email_template_path(template), class: "btn btn-primary btn-sm me-1"
          = link_to "Delete", email_template_path(template), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-danger btn-sm me-1"
          = link_to "Preview", preview_email_template_path(template), class: "btn btn-success btn-sm"
